{
  "scopeName": "source.apexx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#annotations" },
    { "include": "#tuples" },
    { "include": "#lambdas" },
    { "include": "#funcTypes" },
    { "include": "#collectionHelpers" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "source.apex" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.apexx", "match": "//.*$" },
        {
          "name": "comment.block.apexx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.apexx",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.apexx", "match": "\\\\." }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "match": "(@)([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.apexx" },
            "2": { "name": "entity.name.function.decorator.apexx" }
          }
        }
      ]
    },
    "tuples": {
      "patterns": [
        {
          "match": "(\\bMap\\s*<\\s*[^,>]+,\\s*)(\\()([^()]+(?:,[^()]+)+)(\\))(\\s*>)",
          "captures": {
            "1": { "name": "storage.type.map.apexx" },
            "2": { "name": "punctuation.definition.tuple.begin.apexx" },
            "3": { "name": "storage.type.tuple.apexx" },
            "4": { "name": "punctuation.definition.tuple.end.apexx" },
            "5": { "name": "storage.type.map.apexx" }
          }
        },
        {
          "match": "(\\.put\\s*\\([^,]+,\\s*)(\\()([^()]+(?:,[^()]+)+)(\\))",
          "captures": {
            "2": { "name": "punctuation.definition.tuple.begin.apexx" },
            "3": { "name": "meta.tuple.literal.apexx" },
            "4": { "name": "punctuation.definition.tuple.end.apexx" }
          }
        },
        {
          "match": "(\\()([^()]+(?:,[^()]+)+)(\\))(?=\\s+[A-Za-z][A-Za-z0-9_]*\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.definition.tuple.begin.apexx" },
            "2": { "name": "storage.type.tuple.apexx" },
            "3": { "name": "punctuation.definition.tuple.end.apexx" }
          }
        },
        {
          "match": "(\\()(?=\\s*(?:Func\\s*<[^>]+>|[A-Za-z][A-Za-z0-9_.<>]*)\\s+[A-Za-z][A-Za-z0-9_]*\\s*,)|(?<=return\\s)(\\()(?=[^;]+,)",
          "captures": {
            "1": { "name": "punctuation.definition.tuple.begin.apexx" },
            "2": { "name": "punctuation.definition.tuple.begin.apexx" }
          }
        }
      ]
    },
    "lambdas": {
      "patterns": [
        {
          "match": "\\b([A-Za-z][A-Za-z0-9_]*)\\s*(=>)",
          "captures": {
            "1": { "name": "variable.parameter.lambda.apexx" },
            "2": { "name": "keyword.operator.lambda.apexx" }
          }
        },
        {
          "match": "(\\()([^)]*)(\\))(\\s*)(=>)",
          "captures": {
            "1": { "name": "punctuation.definition.parameters.begin.apexx" },
            "2": { "name": "variable.parameter.lambda.apexx" },
            "3": { "name": "punctuation.definition.parameters.end.apexx" },
            "5": { "name": "keyword.operator.lambda.apexx" }
          }
        },
        { "name": "keyword.operator.lambda.apexx", "match": "=>" }
      ]
    },
    "funcTypes": {
      "patterns": [
        {
          "begin": "\\b(Func)(\\s*)(<)",
          "beginCaptures": {
            "1": { "name": "storage.type.function.apexx" },
            "3": { "name": "punctuation.definition.generic.begin.apexx" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.generic.end.apexx" }
          },
          "patterns": [
            { "name": "entity.name.type.apexx", "match": "\\b[A-Za-z][A-Za-z0-9_.]*\\b" },
            { "name": "punctuation.separator.comma.apexx", "match": "," }
          ]
        }
      ]
    },
    "collectionHelpers": {
      "patterns": [
        {
          "name": "support.function.collection.apexx",
          "match": "\\b(?:filter|map|flatMap|find|any|all|count)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.apexx",
          "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d+|\\d+)(?![A-Za-z0-9_])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.apexx",
          "match": "\\b(if|else|for|while|do|return|try|catch|finally|throw|switch|when|break|continue|new)\\b"
        },
        {
          "name": "storage.modifier.apexx",
          "match": "\\b(public|private|protected|global|static|final|virtual|abstract|override|transient|testMethod|webservice|with|without|inherited|sharing)\\b"
        },
        {
          "name": "storage.type.apexx",
          "match": "\\b(class|interface|enum|void|Boolean|bool|Integer|int|Long|Decimal|Double|String|string|Id|Object|Date|Datetime|DateTime|Time|List|Set|Map)\\b"
        },
        {
          "name": "constant.language.apexx",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    }
  }
}
