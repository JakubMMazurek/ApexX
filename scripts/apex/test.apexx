List<Integer> numbers = new List<Integer> {
    1, 2, 3, 4, 5, 6, 7
};

System.debug(
    numbers
        .filter(n => n > 3)
        .map(n => n * 2)
);

System.debug(
    numbers
        .map(n => n > 3 ? 'High' : 'Low')
);

public (Integer, Integer) getDoubledAndTripled(Integer i) {
    return (i * 2, i * 3);
}

(Integer doubled, Integer tripled) = getDoubledAndTripled(10);
System.debug(doubled);
System.debug(tripled);