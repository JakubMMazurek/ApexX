public with sharing class AccountService {
    private static final Decimal MIN_REVENUE_PER_EMPLOYEE = 10000;

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static List<Account> loadPriorityAccounts() {
        return priorityAccounts(demoAccounts());
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static List<String> loadNormalizedContactEmails() {
        return normalizedContactEmails(demoAccountsWithContacts());
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static List<AccountWorkItem> loadRenewalWork() {
        return renewalWork(demoAccounts(), 'Revenue Risk');
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static AccountSummary loadAccountSummary() {
        return summarize(demoAccountsWithContacts());
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static Boolean loadRevenueComparison() {
        List<Account> accounts = demoAccounts();
        List<Account> withRevenue = accounts
            .filter(account => account.AnnualRevenue != null);

        return withRevenue.size() > 1
            && compareRevenue(withRevenue.get(0), withRevenue.get(1), 1000);
    }

    @AuraEnabled
    @UserFriendlyError
    public static void triggerUserFriendlyError() {
        String missingValue = null;
        missingValue.trim();
    }

    @AuraEnabled
    @UserFriendlyError(message = 'Unable to save account.')
    public static Account save(Account account, Boolean validate) {
        if (validate) {
            account.Name = account.Name.trim();
        }
        update account;
        return account;
    }

    public static List<Account> demoAccounts() {
        return [
            SELECT Id, Name, OwnerId, Rating, AccountNumber, AnnualRevenue, NumberOfEmployees
            FROM Account
            WHERE Name LIKE 'ApexX Demo%'
            ORDER BY Name
            LIMIT 50
        ];
    }

    public static List<Account> demoAccountsWithContacts() {
        return [
            SELECT Id, Name, OwnerId, Rating, AccountNumber, AnnualRevenue, NumberOfEmployees,
                (SELECT Id, FirstName, LastName, Email FROM Contacts)
            FROM Account
            WHERE Name LIKE 'ApexX Demo%'
            ORDER BY Name
            LIMIT 50
        ];
    }

    public static List<Account> priorityAccounts(List<Account> accounts) {
        return accounts
            .filter(account =>
                account.AccountNumber != null
                && account.AnnualRevenue != null
                && account.NumberOfEmployees != null
                && account.NumberOfEmployees > 0
                && account.AnnualRevenue / account.NumberOfEmployees >= MIN_REVENUE_PER_EMPLOYEE
            );
    }

    public static List<String> normalizedContactEmails(List<Account> accounts) {
        return accounts
            .flatMap(account => account.Contacts)
            .filter(contact =>
                contact.Email != null
                && contact.Email.contains('@')
            )
            .map(contact => contact.Email.trim().toLowerCase());
    }

    public static List<AccountWorkItem> renewalWork(List<Account> accounts, String mode = 'Revenue Risk') {
        Func<Account, Boolean> shouldEscalate;

        if (mode == 'Revenue Risk') {
            shouldEscalate = (account) =>
                account.AnnualRevenue != null
                && account.AnnualRevenue >= 250000;
        } else {
            shouldEscalate = (account) =>
                account.Rating == 'Hot'
                && account.AccountNumber != null;
        }

        return buildRenewalWork(accounts, shouldEscalate);
    }

    public static List<AccountWorkItem> buildRenewalWork(
        List<Account> accounts,
        Func<Account, Boolean> shouldEscalate
    ) {
        return accounts.map(account => {
            Boolean escalate = shouldEscalate(account);
            return new AccountWorkItem(
                account.Id,
                account.Name,
                account.OwnerId,
                escalate ? 'High' : 'Normal',
                escalate ? 'Revenue review' : 'Standard renewal'
            );
        });
    }

    public static AccountSummary summarize(List<Account> accounts) {
        Func<Account, Boolean> isHot = (account) => account.Rating == 'Hot';

        Integer hotCount = accounts.count(account => isHot(account));
        Boolean allHaveNumbers = accounts.all(account => account.AccountNumber != null);
        Account firstHot = accounts.find(account => isHot(account));
        List<String> names = accounts
            .filter(account => account.Name != null)
            .map(account => account.Name);

        return new AccountSummary(hotCount, allHaveNumbers, firstHot, names);
    }

    public static Boolean compareRevenue(Account left, Account right, Decimal tolerance = 0) {
        return left.AnnualRevenue == right.AnnualRevenue
            || (left.AnnualRevenue - right.AnnualRevenue).abs() <= tolerance;
    }

    public class AccountSummary {
        @AuraEnabled public Integer hotCount { get; set; }
        @AuraEnabled public Boolean allHaveNumbers { get; set; }
        @AuraEnabled public Account firstHot { get; set; }
        @AuraEnabled public List<String> names { get; set; }

        public AccountSummary(
            Integer hotCount,
            Boolean allHaveNumbers,
            Account firstHot,
            List<String> names
        ) {
            this.hotCount = hotCount;
            this.allHaveNumbers = allHaveNumbers;
            this.firstHot = firstHot;
            this.names = names;
        }
    }

    public class AccountWorkItem {
        @AuraEnabled public Id accountId { get; set; }
        @AuraEnabled public String accountName { get; set; }
        @AuraEnabled public Id ownerId { get; set; }
        @AuraEnabled public String priority { get; set; }
        @AuraEnabled public String reason { get; set; }

        public AccountWorkItem(
            Id accountId,
            String accountName,
            Id ownerId,
            String priority,
            String reason
        ) {
            this.accountId = accountId;
            this.accountName = accountName;
            this.ownerId = ownerId;
            this.priority = priority;
            this.reason = reason;
        }
    }
}
