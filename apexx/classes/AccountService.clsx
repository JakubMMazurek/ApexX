public with sharing class AccountService {
    private static final Decimal MIN_REVENUE_PER_EMPLOYEE = 10000;

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static List<Account> loadPriorityAccounts() {
        return priorityAccounts(demoAccounts());
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static List<String> loadNormalizedContactEmails() {
        return normalizedContactEmails(demoAccountsWithContacts());
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static List<AccountWorkItem> loadRenewalWork() {
        return renewalWork(demoAccounts(), 'Revenue Exposure');
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static AccountSummary loadAccountSummary() {
        return summarize(demoAccountsWithContacts());
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static Boolean loadRevenueComparison() {
        List<Account> accounts = demoAccounts();
        List<Account> withRevenue = accounts
            .filter(account => account.AnnualRevenue != null);

        return withRevenue.size() > 1
            && compareRevenue(withRevenue.get(0), withRevenue.get(1), 1000);
    }

    @AuraEnabled
    @UserFriendlyError(message = 'The operation failed safely. Internal details were hidden.')
    public static void triggerUserFriendlyError() {
        String missingValue = null;
        missingValue.trim();
    }

    @AuraEnabled
    public static void triggerRawError() {
        String missingValue = null;
        missingValue.trim();
    }

    @AuraEnabled
    @UserFriendlyError(message = 'Unable to save account.')
    public static Account save(Account account, Boolean validate) {
        if (validate) {
            account.Name = account.Name.trim();
        }
        update account;
        return account;
    }

    public static List<Account> demoAccounts() {
        return [
            SELECT Id, Name, OwnerId, Rating, AccountNumber, AnnualRevenue, NumberOfEmployees
            FROM Account
            WHERE Name LIKE 'ApexX Demo%'
            ORDER BY Name
            LIMIT 50
        ];
    }

    public static List<Account> demoAccountsWithContacts() {
        return [
            SELECT Id, Name, OwnerId, Rating, AccountNumber, AnnualRevenue, NumberOfEmployees,
                (SELECT Id, FirstName, LastName, Email FROM Contacts)
            FROM Account
            WHERE Name LIKE 'ApexX Demo%'
            ORDER BY Name
            LIMIT 50
        ];
    }

    public static List<Account> priorityAccounts(List<Account> accounts) {
        return accounts
            .filter(account =>
                account.AccountNumber != null
                && account.AnnualRevenue != null
                && account.NumberOfEmployees != null
                && account.NumberOfEmployees > 0
                && account.AnnualRevenue / account.NumberOfEmployees >= MIN_REVENUE_PER_EMPLOYEE
            );
    }

    public static List<String> normalizedContactEmails(List<Account> accounts) {
        return accounts
            .flatMap(account => account.Contacts)
            .filter(contact =>
                contact.Email != null
                && contact.Email.contains('@')
            )
            .map(contact => contact.Email.trim().toLowerCase());
    }

    public static List<AccountWorkItem> renewalWork(List<Account> accounts, String mode = 'Revenue Exposure') {
        (
            Func<Account, Boolean> shouldEscalate,
            String escalationReason,
            Decimal _
        ) = PortfolioRuleProvider.resolve(mode);

        return buildRenewalWork(accounts, shouldEscalate, escalationReason);
    }

    public static List<AccountWorkItem> buildRenewalWork(
        List<Account> accounts,
        Func<Account, Boolean> shouldEscalate,
        String escalationReason
    ) {
        return accounts.map(account => {
            Boolean escalate = shouldEscalate(account);
            return new AccountWorkItem(
                account.Id,
                account.Name,
                account.OwnerId,
                escalate ? 'High' : 'Normal',
                escalate ? escalationReason : 'Standard renewal'
            );
        });
    }

    public static List<AccountWorkItem> buildSelectedWork(
        List<Account> accounts,
        String reason
    ) {
        return accounts.map(account => new AccountWorkItem(
            account.Id,
            account.Name,
            account.OwnerId,
            'High',
            reason
        ));
    }

    public static StrategyResult evaluateRenewalStrategy(
        List<Account> accounts,
        String mode,
        Func<Account, Boolean> shouldEscalate,
        String escalationReason
    ) {
        Integer matchCount = accounts.count(account => shouldEscalate(account));
        Account firstMatch = accounts.find(account => shouldEscalate(account));
        List<AccountWorkItem> items = buildRenewalWork(
            accounts,
            shouldEscalate,
            escalationReason
        );

        return new StrategyResult(
            mode,
            accounts.size(),
            matchCount,
            firstMatch == null ? null : firstMatch.Name,
            items
        );
    }

    public static AccountSummary summarize(List<Account> accounts) {
        Func<Account, Boolean> isHot = (account) => account.Rating == 'Hot';

        Integer hotCount = accounts.count(account => isHot(account));
        Boolean allHaveNumbers = accounts.all(account => account.AccountNumber != null);
        Account firstHot = accounts.find(account => isHot(account));
        List<String> names = accounts
            .filter(account => account.Name != null)
            .map(account => account.Name);

        return new AccountSummary(hotCount, allHaveNumbers, firstHot, names);
    }

    public static Boolean compareRevenue(
        Account left,
        Account right,
        Decimal absoluteTolerance = 0,
        Decimal percentageTolerance = 0
    ) {
        if (left.AnnualRevenue == null || right.AnnualRevenue == null) {
            return false;
        }

        Decimal difference = (left.AnnualRevenue - right.AnnualRevenue).abs();
        Decimal baseline = left.AnnualRevenue.abs();
        Decimal percentageDifference = baseline == 0
            ? (difference == 0 ? 0 : 100)
            : difference / baseline * 100;

        return difference <= absoluteTolerance
            || percentageDifference <= percentageTolerance;
    }

    public static PortfolioBriefing buildPortfolioBriefing(
        List<Account> accounts,
        String mode = 'Revenue Exposure',
        Decimal minimumRevenue = 100000
    ) {
        (
            Func<Account, Boolean> matchesStrategy,
            String escalationReason,
            Decimal exposureThreshold
        ) = PortfolioRuleProvider.resolve(mode);

        List<Account> selected = accounts
            .filter(account =>
                account.AnnualRevenue != null
                && account.AnnualRevenue >= minimumRevenue
            )
            .filter(account => matchesStrategy(account));

        List<AccountWorkItem> workItems = buildSelectedWork(
            selected,
            escalationReason
        );
        List<String> stakeholderEmails = selected
            .flatMap(account => account.Contacts)
            .filter(contact => contact.Email != null)
            .map(contact => contact.Email.trim().toLowerCase());

        return new PortfolioBriefing(
            mode,
            minimumRevenue,
            exposureThreshold,
            accounts.size(),
            selected.size(),
            workItems,
            stakeholderEmails
        );
    }

    @AuraEnabled(cacheable=true)
    @UserFriendlyError
    public static ShowcaseOverview loadShowcaseOverview() {
        List<Account> accounts = demoAccountsWithContacts();
        List<AccountSnapshot> snapshots = new List<AccountSnapshot>();

        for (Account account : accounts) {
            snapshots.add(new AccountSnapshot(
                account.Id,
                account.Name,
                account.Rating,
                account.AccountNumber,
                account.AnnualRevenue,
                account.NumberOfEmployees,
                account.Contacts.size()
            ));
        }

        return new ShowcaseOverview(snapshots);
    }

    @AuraEnabled
    @UserFriendlyError
    public static EmailPipelineResult runEmailPipeline() {
        return inspectPortfolio(demoAccountsWithContacts());
    }

    public static EmailPipelineResult inspectPortfolio(List<Account> accounts) {
        List<Contact> contacts = accounts.flatMap(account => account.Contacts);
        List<String> emails = contacts
            .filter(contact => contact.Email != null && contact.Email.contains('@'))
            .map(contact => contact.Email.trim().toLowerCase());
        Integer hotCount = accounts.count(account => account.Rating == 'Hot');
        Boolean anyMissingNumber = accounts.any(account => account.AccountNumber == null);
        Boolean allHaveRevenue = accounts.all(account => account.AnnualRevenue != null);
        Account firstHighValue = accounts.find(account =>
            account.AnnualRevenue != null
            && account.AnnualRevenue >= 250000
        );

        return new EmailPipelineResult(
            accounts.size(),
            contacts.size(),
            emails.size(),
            emails,
            hotCount,
            anyMissingNumber,
            allHaveRevenue,
            firstHighValue == null ? null : firstHighValue.Name
        );
    }

    @AuraEnabled
    @UserFriendlyError
    public static StrategyResult runRenewalStrategy(String mode) {
        return evaluateMode(demoAccounts(), mode);
    }

    public static StrategyResult evaluateMode(
        List<Account> accounts,
        String mode
    ) {
        Decimal exposureThreshold = 250000;
        Func<Account, Boolean> rule;
        String reason;

        if (mode == 'Revenue Exposure') {
            rule = (account) => {
                Decimal revenue = account.AnnualRevenue == null
                    ? 0
                    : account.AnnualRevenue;
                return revenue >= exposureThreshold;
            };
            reason = 'Revenue exposure';
        } else if (mode == 'Sales Ready') {
            rule = (account) => {
                Boolean hasNumber = account.AccountNumber != null;
                return account.Rating == 'Hot' && hasNumber;
            };
            reason = 'Sales ready';
        } else {
            rule = (account) => account.AccountNumber == null;
            reason = 'Missing account number';
        }

        return evaluateRenewalStrategy(
            accounts,
            mode,
            rule,
            reason
        );
    }

    @AuraEnabled
    @UserFriendlyError
    public static TupleDemoResult runTupleDemo() {
        return AccountSignalConsumer.buildResult(demoAccounts());
    }

    @AuraEnabled
    @UserFriendlyError
    public static RevenueComparisonResult runRevenueComparison(
        Decimal absoluteTolerance,
        Decimal percentageTolerance
    ) {
        List<Account> accounts = [
            SELECT Id, Name, AnnualRevenue
            FROM Account
            WHERE AccountNumber IN ('APXX-001', 'APXX-002')
            ORDER BY AccountNumber
        ];

        Account left = accounts.get(0);
        Account right = accounts.get(1);
        Decimal effectiveAbsolute = absoluteTolerance == null ? 0 : absoluteTolerance;
        Decimal effectivePercentage = percentageTolerance == null ? 0 : percentageTolerance;
        Boolean matches;
        String callShape;

        if (absoluteTolerance == null) {
            matches = compareRevenue(left, right);
            callShape = 'compareRevenue(left, right)';
        } else if (percentageTolerance == null) {
            matches = compareRevenue(left, right, absoluteTolerance);
            callShape = 'compareRevenue(left, right, absoluteTolerance)';
        } else {
            matches = compareRevenue(
                left,
                right,
                absoluteTolerance,
                percentageTolerance
            );
            callShape = 'compareRevenue(left, right, absoluteTolerance, percentageTolerance)';
        }

        return new RevenueComparisonResult(
            left.Name,
            left.AnnualRevenue,
            right.Name,
            right.AnnualRevenue,
            effectiveAbsolute,
            effectivePercentage,
            callShape,
            matches
        );
    }

    @AuraEnabled
    @UserFriendlyError(message = 'Unable to build the portfolio briefing.')
    public static PortfolioBriefing runPortfolioBriefing(String mode, Decimal minimumRevenue) {
        List<Account> accounts = demoAccountsWithContacts();
        return minimumRevenue == null
            ? buildPortfolioBriefing(accounts, mode)
            : buildPortfolioBriefing(accounts, mode, minimumRevenue);
    }

    public class AccountSummary {
        @AuraEnabled public Integer hotCount { get; set; }
        @AuraEnabled public Boolean allHaveNumbers { get; set; }
        @AuraEnabled public Account firstHot { get; set; }
        @AuraEnabled public List<String> names { get; set; }

        public AccountSummary(
            Integer hotCount,
            Boolean allHaveNumbers,
            Account firstHot,
            List<String> names
        ) {
            this.hotCount = hotCount;
            this.allHaveNumbers = allHaveNumbers;
            this.firstHot = firstHot;
            this.names = names;
        }
    }

    public class AccountWorkItem {
        @AuraEnabled public Id accountId { get; set; }
        @AuraEnabled public String accountName { get; set; }
        @AuraEnabled public Id ownerId { get; set; }
        @AuraEnabled public String priority { get; set; }
        @AuraEnabled public String reason { get; set; }

        public AccountWorkItem(
            Id accountId,
            String accountName,
            Id ownerId,
            String priority,
            String reason
        ) {
            this.accountId = accountId;
            this.accountName = accountName;
            this.ownerId = ownerId;
            this.priority = priority;
            this.reason = reason;
        }
    }

    public class ShowcaseOverview {
        @AuraEnabled public List<AccountSnapshot> records { get; set; }

        public ShowcaseOverview(List<AccountSnapshot> records) {
            this.records = records;
        }
    }

    public class AccountSnapshot {
        @AuraEnabled public Id accountId { get; set; }
        @AuraEnabled public String name { get; set; }
        @AuraEnabled public String rating { get; set; }
        @AuraEnabled public String accountNumber { get; set; }
        @AuraEnabled public Decimal annualRevenue { get; set; }
        @AuraEnabled public Integer employees { get; set; }
        @AuraEnabled public Integer contactCount { get; set; }

        public AccountSnapshot(
            Id accountId,
            String name,
            String rating,
            String accountNumber,
            Decimal annualRevenue,
            Integer employees,
            Integer contactCount
        ) {
            this.accountId = accountId;
            this.name = name;
            this.rating = rating;
            this.accountNumber = accountNumber;
            this.annualRevenue = annualRevenue;
            this.employees = employees;
            this.contactCount = contactCount;
        }
    }

